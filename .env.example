# ==============================================================================
# B-Roll Studio — Environment Configuration
# All settings, limits, model names, and paths are read through this configuration.
# Integration Standard Point 1 & 6: Zero hard-coded paths or mandatory paid keys.
# ==============================================================================

# Application Environment & Server
APP_ENV=development
APP_NAME=B-Roll Studio
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=broll-studio-insecure-secret-key-change-in-production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# Database Configuration (PostgreSQL in production/Docker, SQLite fallback for local test/dev)
# PostgreSQL default: postgresql+asyncpg://postgres:postgres@localhost:5432/broll_studio
DATABASE_URL=sqlite+aiosqlite:///./broll_studio.db
DATABASE_SYNC_URL=sqlite:///./broll_studio.db

# Background Task Queue (Redis + Celery in production/Docker, in-memory queue fallback)
# Production: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_LOCAL_TASK_RUNNER=true

# Object Storage Configuration (MinIO S3-compatible or local directory)
# Choices: "local" or "s3"
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./artifacts/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=broll-studio
MINIO_SECURE=false

# Media Processing Binaries (FFmpeg & FFprobe)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# AI & Processing Adapters
# TTS Options: "edge" (Microsoft Neural TTS) or "mock" (offline synthesizer)
TTS_PROVIDER=edge
DEFAULT_VOICE=en-IN-female

# Speech-to-Text Options: "whisper_mock" or "energy_segmenter"
STT_PROVIDER=whisper_mock

# Footage Providers Configuration
# Primary: "curated_stock" (curated commercially-licensed stock clips)
# Secondary: "procedural_gen" (generative procedural motion graphics)
# Fallback: "deterministic_mock" (offline fixtures for tests)
FOOTAGE_PRIMARY=curated_stock
FOOTAGE_SECONDARY=procedural_gen
FOOTAGE_FALLBACK=deterministic_mock

# Relevance Evaluator: "semantic_vlm" (independent scoring) or "heuristic"
RELEVANCE_EVALUATOR=semantic_vlm

# Guardrails & Limits
MAX_AUDIO_DURATION_SEC=600
MAX_FILE_SIZE_MB=100
MAX_SCRIPT_CHAR_LENGTH=10000
DEFAULT_ASPECT_RATIOS=["16:9","9:16"]
RENDER_FPS=30
RENDER_CRF=23
RENDER_PRESET=fast

# Webhook Callback Configuration
WEBHOOK_TIMEOUT_SEC=10
WEBHOOK_HMAC_SECRET=incubrix-webhook-secret-key-2026
